        }}
        onRowsPerPageChange={(e) => {
          const size = e.target.value ? Number(e.target.value) : 10;
          props.setTableManagement({ rowsPerPage: size });
        }}
        ActionsComponent={TablePaginationActions}
      />
    </Box>
  );
};

interface FilterProps {
  column: KeysSearchRequestDto;
  label: string;
  placeholder: string;
  changeId: string;
  tableManagement: TableManagement;
  setTableManagement: React.Dispatch<React.SetStateAction<TableManagement>>;
}

const Filter = (props: FilterProps) => {
  const queryClient = useQueryClient();
  const [inputValue, setInputValue] = useState('');
  const debounceTimeout = useRef(null);

  const handleInputChange = (e: { target: { value: any } }) => {
    const value = e.target.value;
    setInputValue(value);

    if (debounceTimeout.current) {
      clearTimeout(debounceTimeout.current);
    }

    debounceTimeout.current = setTimeout(() => {
      filter(value);
    }, 500);
  };

  const filter = useCallback(
    (value: string) => {
      queryClient.invalidateQueries({
        queryKey: [`phraseProjectChangeKeys-${props.changeId}`],
      });

      console.log(value, inputValue);
      props.setTableManagement({
        filters: {
          name: value,
        },
      });
    },
    [queryClient, props],
  );

  useEffect(() => {
    return () => {
      if (debounceTimeout.current) {
        clearTimeout(debounceTimeout.current);
      }
    };
  }, []);

  return (
    <CustomInput
      value={inputValue}
      name={props.label ? props.label : ''}
      onChange={handleInputChange}
      placeholder={props.placeholder ? props.placeholder : ''}
      inputProps={{ 'aria-label': 'search' }}
    />
  );
};

export default KeyListV2;
