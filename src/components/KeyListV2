function getNextCircularSortOrder(
  initialValue: 'none' | 'asc' | 'desc' = 'none',
): 'none' | 'asc' | 'desc' {
  const orders: Array<'none' | 'asc' | 'desc'> = ['none', 'asc', 'desc'];
  let currentIndex = orders.indexOf(initialValue);
  if (currentIndex === -1) {
    throw new Error(
      `Invalid initial value. Must be one of: ${orders.join(', ')}`,
    );
  }

  const nextIndex = (currentIndex + 1) % orders.length;
  currentIndex = nextIndex;
  console.log(
    'getNextCircularSortOrder returns order: ',
    orders[currentIndex] ?? 'none',
  );
  return orders[currentIndex] ?? 'none';
}

