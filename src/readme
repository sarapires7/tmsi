import { handleDigitalEdgeClick } from 'modules/DigitalEdgeHandler'

const listItem = (item: MenuItems, index: number) => {
  if (item.label === 'DigitalEdge') {
    return (
      <ContentMenuItem
        key={`digitalEdge-${index}`}
        item={item}
        handleClick={handleDigitalEdgeClick}
      />
    )
  }

  // resto da função permanece igual
}
